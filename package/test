#%Module1.0#####################################################################
##
## $name modulefile
##
set ver [lrange [split [ module-info name ] / ] 1 1 ]
set name [lrange [split [ module-info name ] / ] 0 0 ]
set imas_home /test/dir
set loading [module-info mode load]
set desc [join [read [ open "$imas_home/etc/modulefiles/$name/.desc" ] ] ]

conflict blitz
prepend-path CPATH              /test/install/dir/include
prepend-path LD_LIBRARY_PATH    /test/install/dir/lib
prepend-path LD_LIBRARY_PATH    /test/install/dir/lib
prepend-path PKG_CONFIG_PATH    /test/install/dir/lib/pkgconfig
