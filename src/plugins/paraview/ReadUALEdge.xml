<ServerManagerConfiguration>
    <ProxyGroup name="sources">
        <SourceProxy name="UAL Edge" class="ReadUALEdge" label="UAL Edge IDS">
            <Documentation
                long_help="Read an Edge IDS"
                short_help="Read an Edge IDS">
            </Documentation>

            <IntVectorProperty
                name="Shot"
                command="SetShot"
                number_of_elements="1"
                default_values="16151"
                panel_visibility="default">
                <IntRangeDomain name="range"/>
                <Documentation>
                    The values of this property sets the case Shot number.
                </Documentation>
            </IntVectorProperty>

            <IntVectorProperty
                name="Run"
                command="SetRun"
                number_of_elements="1"
                default_values="1000"
                panel_visibility="default">
                <IntRangeDomain name="range"/>
                <Documentation>
                    The values of this property sets the case Run number.
                </Documentation>
            </IntVectorProperty>

            <StringVectorProperty
                name="User"
				label="User"
				command="SetUser"
				number_of_elements="1"
				default_values="kosl"
				panel_visibility="default"
                immediate_update="true">
                <Documentation>
                    This property specifies the user for the UAL Database.
                </Documentation>
            </StringVectorProperty>

            <StringVectorProperty
                name="Device"
                label="Device"
                command="SetDevice"
                number_of_elements="1"
                default_values="solps-iter"
                panel_visibility="default"
                immediate_update="true">
                <Documentation>
                    This property specifies the Device for the UAL Database.
                </Documentation>
            </StringVectorProperty>

            <StringVectorProperty
                name="LoadIDS"
                label="IDS to load"
                command="SetLoadIDS"
                number_of_elements="1"
                default_values="edge_profiles"
                immediate_update="true">
                <StringListDomain name="LoadIDSstringList">
                    <String value="edge_profiles"/>
                    <String value="edge_sources"/>
                    <String value="edge_transport"/>
                </StringListDomain>
                <Documentation>
                    This property specifies the IDS to open. The geometry is
                    currently taken from edge_profiles IDS, this selection
                    affects what data fields are read.
                </Documentation>
            </StringVectorProperty>

            <IntVectorProperty
                name="EdgeSourcesSourceID"
                label=".source(#)"
                command="SetEdgeSourcesSourceID"
                number_of_elements="1"
                default_values="0"
                panel_visibility="advanced">
                <IntRangeDomain name="range"/>
                <Documentation>
                    This property specifies the edge_sources.source(:) IDS
                    structure array index. Python notation (0, 1, 2, ...).
                    Default value = 0.
                </Documentation>
                <Hints>
                   <WidgetHeight number_of_rows="1"/>
                   <WidgetWidth number_of_rows="1"/>
                   <PropertyWidgetDecorator type="my_decorator_EdgeSources"/>
                </Hints>
            </IntVectorProperty>

            <IntVectorProperty
                name="EdgeTransportModelID"
                label=".model(#)"
                command="SetEdgeTransportModelID"
                number_of_elements="1"
                default_values="0"
                panel_visibility="advanced">
                <IntRangeDomain name="range"/>
                <Documentation>
                    This property specifies the edge_transport.model(:) IDS
                    structure array index. Python notation (0, 1, 2, ...).
                    Default value = 0.
                </Documentation>
                <Hints>
                   <WidgetHeight number_of_rows="1"/>
                   <WidgetWidth number_of_rows="1"/>
                   <PropertyWidgetDecorator type="my_decorator_EdgeTransport"/>
                </Hints>
            </IntVectorProperty>

            <IntVectorProperty
                name="GGDslice"
                label=".ggd(#)"
                command="SetGGDslice"
                number_of_elements="1"
                default_values="0"
                panel_visibility="advanced">
                <IntRangeDomain name="range"/>
                <Documentation>
                    The values of this property sets the GGD
                    structure array index. Python notation (0, 1, 2, ...).
                    Default value = 0.
                </Documentation>
            </IntVectorProperty>

            <StringVectorProperty
                name="LoadIDSGeom"
                label="Take geometry from"
                command="SetLoadIDSGeom"
                number_of_elements="1"
                default_values="edge_profiles"
                panel_visibility="advanced"
                immediate_update="true">
                <StringListDomain name="LoadIDSGeomstringList">
                    <String value="edge_profiles"/>
                    <String value="edge_sources"/>
                    <String value="edge_transport"/>
                </StringListDomain>
                <Documentation>
                    This property specifies the IDS from which the geometry is
                    to be read. This is implemented due to cases when grid
                    geometry, stored in edge_profiles IDS, was shared with
                    edge_sources and edge_transport IDSs, while each IDS
                    had its own stored data fields.
                </Documentation>
            </StringVectorProperty>

            <Property
                name="Refresh"
                command="Modified"
                panel_widget="command_button"
                width="5"/>

            <IntVectorProperty
                name="IDSListCheckBox"
                label="Show list of available IDS Shot/Run cases"
                command="SetIDSListCheckBox"
                number_of_elements="1"
                default_values="0"
                panel_visibility="default">
		 	    <BooleanDomain name="bool"/>
		 	    <Documentation>
				    This checkbox opens the list of available IDSs for
                    specified user.
		 	    </Documentation>
            </IntVectorProperty>

            <StringVectorProperty
                name="ShotRunList"
                label="IDS List"
                number_of_elements="0"
                number_of_elements_per_command="2"
                element_types="2"
                repeat_command ="1"
                panel_visibility="default">
		 	    <Documentation>
    			 	List of available Shot/Run-s for specified user.
		 	    </Documentation>
		 	    <Hints>
			 	   <WidgetHeight number_of_rows="12"/>
			 	   <PropertyWidgetDecorator type="my_decorator"/>
		 	    </Hints>
            </StringVectorProperty>
            <Hints>
                <ShowInMenu category="IMAS"/>
            </Hints>
        </SourceProxy>
    </ProxyGroup>
</ServerManagerConfiguration>
