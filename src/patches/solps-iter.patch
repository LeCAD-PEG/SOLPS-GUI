diff --git a/SETUP/config.UNKNOWN.gfortran b/SETUP/config.UNKNOWN.gfortran
new file mode 100644
index 00000000..b4925797
--- /dev/null
+++ b/SETUP/config.UNKNOWN.gfortran
@@ -0,0 +1,153 @@
+#
+# Specify paths to root-directories of following libraries on your system
+#
+# Special notes:
+#
+# If you have NCAR version 3 on your system:
+# Remove -DNCAR4 from SOLPS_CPP
+#
+# If you do not have NAG on your system:
+# Use LD_NAG to link to the BLASLAPACK library instead
+# Add -DNO_NAG to SOLPS_CPP
+#
+# If you have NAG Mark 17 or greater on your system:
+# Add -DNO_F01AAF to SOLPS_CPP
+#
+# If you have NAG Mark 22 or greater on your system:
+# Add -DNAG22 to SOLPS_CPP
+#
+
+    NODENAME ?= $(shell echo `hostname`)
+#        NCDIR ?= ${SOLPSLIB} # Provided by SOLPS-GUI build script
+#    MSCL_ROOT ?= ${SOLPSLIB} # Provided by SOLPS-GUI build script
+#        H5DIR ?= ${SOLPSLIB} # Provided by SOLPS-GUI build script
+#      GR_ROOT ?= ${SOLPSLIB} # Provided by SOLPS-GUI build script
+#     GLI_HOME ?= ${SOLPSLIB} # Provided by SOLPS-GUI build script
+#OPENBLAS_ROOT ?= ${SOLPSLIB} # Provided by SOLPS-GUI build script
+#  MDSPLUS_DIR ?= ${SOLPSLIB} # Provided by SOLPS-GUI build script
+
+# The library path when installing NCARG on Debian9 is
+# /usr/lib/x86_64-linux-gnu/ncarg
+# But on CentOS7, it's
+# /usr/lib64/ncarg
+# The same goes for OpenMP, so the best way is to provide the PKG_CONFIG_PATH,
+# or run the SOLPS-GUI build script.
+
+   NCARG_ROOT ?= ${SOLPSLIB} # Provided by SOLPS-GUI build script
+        MPDIR ?= ${SOLPSLIB} # Provided by SOLPS-GUI build script
+
+        NAGDIR ?= ${SOLPSLIB}
+#
+# Variables of linking, using pkg-config
+#
+# LD_INTEL_LIBS= -lirc -lirc_s -liomp5 -lifcoremt_pic -lsvml -lifport -limf -lm -lifcore_pic -lpthread
+
+LD_NETCDF  = `nf-config --flibs` # from staging/netcdf/<version>/bin
+LD_MSCL    = `pkg-config mscl --libs` -lgfortran # from staging/mscl/<version>/lib/pkgconfig
+LD_GR      = -L${GR_ROOT}/lib -lgr
+LD_GKS     = -L${GLI_HOME} -lgks -lXmu -lX11 -lXt -ldl
+LD_NCARG   = -L${NCARG_ROOT} -lncarg -lncarg_gks -lncarg_c -lX11 -lXext -lcairo -lfontconfig -lfreetype -lpng -lz -lXrender -lbz2 -ldl # For NCARG v6.x.x
+LD_NAG     = -L${OPENBLAS_ROOT} -lopenblas
+LD_MDSPLUS = -L${MDSPLUS_DIR}/lib -lMdsLib_client -lMdsIpShr -lMdsShr
+LD_SONNET  = -L${SOLPSLIB}/lib -lsonnet -lstdc++
+LD_MPI     = -L${MPDIR}/lib -lmpi
+
+#
+# Preprocessor options
+#
+
+SOLPS_CPP      = -DNCAR4 -DNO_NAG -DGFORTRAN `pkg-config netcdf-fortran --cflags`
+B25_DEFINES    =
+EIRENE_DEFINES =
+FFLAGSEXTRA    =
+
+# Autodetected optional features...
+
+# Build with NetCDF tools if available
+ifdef LD_NETCDF
+  SOLPS_CPP   += -DCDF_MOVIE
+else
+  SOLPS_CPP   += -DNO_CDF
+endif
+
+# Build with MDSplus tools if MDSplus is present
+ifdef LD_MDSPLUS
+  SOLPS_CPP   += -DMDSPLUS
+endif
+
+# Build with Catalyst if ParaView is in PATH
+ifdef LD_CATALYST
+  SOLPS_CPP   += -DCATALYST
+endif
+
+# Build with IMAS if imas module is loaded
+ifdef IMAS_VERSION
+  UAL_MAJOR_VERSION = $(shell echo ${UAL_VERSION} | cut -d '.' -f1 )
+  IMAS_MAJOR_VERSION = $(shell echo ${IMAS_VERSION} | cut -d '.' -f1 )
+  IMAS_MINOR_VERSION = $(shell echo ${IMAS_VERSION} | cut -d '.' -f2 )
+  ifeq ($(shell test ${IMAS_MINOR_VERSION} -ge 17; echo $$?),0)
+    GGD_MINOR_VERSION = $(shell echo ${GGD_VERSION} | cut -d '.' -f2 )
+    LD_UAL = `pkg-config imas-gfortran ggd --libs`
+  else
+    ifeq ($(shell test ${IMAS_MINOR_VERSION} -ge 12; echo $$?),0)
+      GGD_MINOR_VERSION = $(shell echo ${GGD_VERSION} | cut -d '.' -f2 )
+      LD_UAL = `pkg-config imas-gfortran --libs` -lggd-gfortran
+    else
+      GGD_MINOR_VERSION = 0
+      LD_UAL = `pkg-config imas-lowlevel imas-gfortran --libs`
+    endif
+  endif
+  SOLPS_CPP += -DIMAS -DUAL_MAJOR_VERSION=${UAL_MAJOR_VERSION} -DIMAS_MINOR_VERSION=${IMAS_MINOR_VERSION} -DGGD_MINOR_VERSION=${GGD_MINOR_VERSION}
+  export LD_UAL
+else
+  UAL_MAJOR_VERSION = 0
+  GGD_MINOR_VERSION = 0
+  IMAS_MAJOR_VERSION = 0
+  IMAS_MINOR_VERSION = 0
+endif
+export UAL_MAJOR_VERSION
+export GGD_MINOR_VERSION
+export IMAS_MAJOR_VERSION
+export IMAS_MINOR_VERSION
+
+# Build with OpenMP if requested
+ifdef SOLPS_OPENMP
+  B25_DEFINES += -D_OPENMP
+endif
+
+#
+# Export for use in sub-makefiles
+#
+
+export NCDIR
+export MSCL_ROOT
+export H5DIR
+export GR_ROOT
+export GLI_HOME
+export NCARG_ROOT
+export NAGDIR
+export MDSPLUS_DIR
+
+export LD_NETCDF
+export LD_MSCL
+export LD_GR
+export LD_GKS
+export LD_NCARG
+export LD_NAG
+export LD_MDSPLUS
+export LD_SONNET
+export LD_MPI
+export LD_UAL
+
+export NODENAME
+export SOLPS_CPP
+export FFLAGSEXTRA
+export B25_DEFINES
+export CARRE_DEFINES
+export EIRENE_DEFINES
+export MPI_CPP
+
+#!!!Local Variables:
+#!!! mode: Makefile
+#!!! End:
+
diff --git a/SETUP/setup.csh.UNKNOWN.gfortran b/SETUP/setup.csh.UNKNOWN.gfortran
new file mode 100644
index 00000000..4221e7c1
--- /dev/null
+++ b/SETUP/setup.csh.UNKNOWN.gfortran
@@ -0,0 +1,10 @@
+if (`where paraview-config` == "") then
+  echo "Warning: paraview-config not found. ParaView with Catalyst will not be compiled-in!"
+else
+  # See ParaViewCatalystUsersGuide_v2.pdf Sec 3.7.2 Linking with Python ...
+  set PARAVIEW_LIB=`paraview-config --libs --python | sed s/-L//`
+  setenv LD_LIBRARY_PATH "${PARAVIEW_LIB}:${LD_LIBRARY_PATH}"
+  setenv PYTHONPATH "${PARAVIEW_LIB}/site-packages/vtk:${PYTHONPATH}"
+  setenv PYTHONPATH "${PARAVIEW_LIB}/site-packages:${PYTHONPATH}"
+  setenv LD_CATALYST `paraview-config --libs vtkPVPythonCatalyst`
+endif
diff --git a/SETUP/setup.sh.UNKNOWN.gfortran b/SETUP/setup.sh.UNKNOWN.gfortran
new file mode 100644
index 00000000..001898ad
--- /dev/null
+++ b/SETUP/setup.sh.UNKNOWN.gfortran
@@ -0,0 +1,10 @@
+if [ -x "$(which paraview-config)" ]; then
+  # See ParaViewCatalystUsersGuide_v2.pdf Sec 3.7.2 Linking with Python ...
+  PARAVIEW_LIB=$(paraview-config --libs --python | sed s/-L//)
+  export LD_LIBRARY_PATH="${PARAVIEW_LIB}:${LD_LIBRARY_PATH}"
+  export PYTHONPATH="${PARAVIEW_LIB}/site-packages/vtk:${PYTHONPATH}"
+  export PYTHONPATH="${PARAVIEW_LIB}/site-packages:${PYTHONPATH}"
+  export LD_CATALYST=$(paraview-config --libs vtkPVPythonCatalyst)
+else
+  echo "Warning: paraview-config not found. ParaView with Catalyst will not be compiled-in!"
+fi
