@@ -0,0 +1,46 @@
+#  VERSION : 16.12.2004 23:58
+
+# The version relying on Fujitsu Fortran installed on AFS
+
+LD_GR    ?= -L${GR_ROOT}/lib -lgr
+LD_GKS   ?= -L${GLI_HOME} -lgks -lgfortran -lX11 -lXt -lXmu
+LD_NAG   ?= `pkg-config nag --libs`
+GLI_HOME ?= /work/imas/opt/gks/4.4.74/lib
+
+#DEFINES  = ${SOLPS_CPP} ${EIRENE_DEFINES} -DRECL_UNITS_PER_DOUBLE=8 -DNO_FORT10 -DNO_SHORT_CYCLE -DNO_F01AAF
+#DEFINES  = ${SOLPS_CPP} ${EIRENE_DEFINES} -DTRIANG -DRECL_UNITS_PER_DOUBLE=8 -DNO_FORT10 -DNO_SHORT_CYCLE -DNO_F01AAF
+DEFINES   =
+EQUIVS    =
+
+CPP       = cpp -traditional
+CPPOPTS   = -P -I${srcdir} ${EQUIVS}
+SED       =
+LINK_MOD  =
+
+FC        = gfortran
+
+ifdef SOLPS_DEBUG
+FCOPTS    = -g -fcheck=all -fbacktrace -ffpe-trap=denormal -ffpe-trap=invalid -ffpe-trap=zero -ftrapv -fsignaling-nans
+DEFINES  += -DDBG
+else
+FCOPTS    = -O3
+endif
+
+#COMPILE  = ${FC} -c ${FFLAGS}
+
+NAG       = ${LD_NAG}
+GKS       = ${LD_GR} ${LD_GKS} -lX11 -lXt -lXmu
+
+#LDLIBS   = ${LD_MSCL}-L/usr/local/lib -L/usr/X11R6/lib64
+LDLIBS    =
+LDEXTRA   =
+
+ # new
+
+INCMOD    = -I
+MOD       = mod
+OBJDEST   = -J${OBJDIR} -o ${OBJDIR}/$*.o
+
+BLD       = ar rcv
+
+LD         = gfortran
\ No newline at end of file
diff --git a/modules/Uinp/config/config.UNKNOWN.gfortran b/modules/Uinp/config/config.UNKNOWN.gfortran
new file mode 100644
index 00000000..ea53c707
--- /dev/null
+++ b/modules/Uinp/config/config.UNKNOWN.gfortran
@@ -0,0 +1,36 @@
+#  VERSION : 28.07.99 20:34
+
+# File compiler.macro for Fujitsu frt
+
+LD_MSCL ?= `pkg-config mscl --libs`
+
+ifdef USE_MPI
+FC       = mpif90
+else
+FC       = gfortran
+endif
+FC_VERSION = $(shell echo `gfortran --version | head -1 | awk '{printf "%s ",$$3,"\n"}'`)
+
+ifdef SOLPS_DEBUG
+FFLAGS   = -g -ffpe-trap=denormal -ffpe-trap=invalid -ffpe-trap=zero -ftrapv -fsignaling-nans
+else
+FFLAGS   =
+endif
+ifdef USE_OPENMP
+FFLAGS += -fopenmp
+endif
+ifeq (${FC_VERSION},6.4.0})
+FFLAGS  += -fuse-ld=bfd
+endif
+INCLUDE  = -I${SRCDIR} ${EIRINC} ${B2INC}
+COMPILE  = ${FC} -c ${FFLAGS}
+CPP      = cpp -traditional
+
+MOD      = mod
+LDLIBS   = ${LD_MSCL}
+LDEXTRA  =
+
+#!!!Local Variables:
+#!!! mode: Makefile
+#!!! End:
+
