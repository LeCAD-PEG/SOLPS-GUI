+# General
+module use $HOME/privatemodules
+module use /work/imas/etc/modulefiles
+module use /work/imas/etc/modules/all
+# Modules needed by SOLPS-ITER
+nodename=$(hostname)
+module load IMAS/3.28.0-4.7.2
+module load GGD/1.9.1-GCC-6.4.0-2.28-DD-3.28.0
+export GGD_VERSION=${EBVERSIONGGD}
+module load AMNS/1.3.3-intel-2018a-Python-3.6.4-Java-1.8-DD-3.28.0
+module load matplotlib/2.1.2-intel-2018a-Python-3.6.4
+module load Kepler
+module load FC2K
+module load Viz
+module load makedepend/1.0.5-GCCcore-6.4.0
+module load MSCL/1.2.0-GCCcore-6.4.0
+module load GR/0.0.94-GCCcore-6.4.0
+module load GLI/4.5.30-GCCcore-6.4.0
+export GLI_HOME=${EBROOTGLI}
+module load flex/2.6.4-GCCcore-6.4.0
+module load Doxygen/1.8.13-GCCcore-6.4.0
+module load TotalView/2017.1.21_linux_x86-64
+module load Ghostscript/9.23-GCCcore-6.4.0
+module unload LibTIFF/4.0.9-GCCcore-6.4.0
+module load ParaView/5.5.2-intel-2018a-Python-3.6.4-mpi
+module load PyQt5/5.9.2-intel-2018a-Python-3.6.4
+export QTDIR=${EBROOTQT5}
+export PARAVIEW_PREFIX=${EBROOTPARAVIEW}
+module load netCDF-Fortran/4.4.4-intel-2018a
+module load motif/2.3.8-intel-2018a
+module load gnuplot/5.2.2-intel-2018a
+module load MATLAB/2018a
+export NCDIR=${EBROOTNETCDFMINFORTRAN}
+export MPDIR=${EBROOTIMPI}
+module load texlive
+
+# Debugger (set environment variable DBX)
+export DBX=totalview
+
+# Compilers
+export CC=gcc
+export FC=gfortran
+export CXX=g++
+
+if [ -x "$(which paraview-config)" ]; then
+  # See ParaViewCatalystUsersGuide_v2.pdf Sec 3.7.2 Linking with Python ...
+  PARAVIEW_LIB=$(paraview-config --libs --python | sed s/-L//)
+  export LD_LIBRARY_PATH="${PARAVIEW_LIB}:${LD_LIBRARY_PATH}"
+  export PYTHONPATH="${PARAVIEW_LIB}/site-packages/vtk:${PYTHONPATH}"
+  export PYTHONPATH="${PARAVIEW_LIB}/site-packages:${PYTHONPATH}"
+  export LD_CATALYST=$(paraview-config --libs vtkPVPythonCatalyst)
+  export LD_CATALYST="${LD_CATALYST} -lstdc++"
+else
+  echo "Warning: paraview-config not found. ParaView with Catalyst will not be compiled-in!"
+fi
+
+# Other environment variables
+# module load solps-gui
+# setenv LD_PRELOAD /usr/lib64/libfontconfig.so.1 # needed by solps-gui
+#setenv LD_LIBRARY_PATH ${LD_LIBRARY_PATH}:/usr/lib64
+#setenv PYTHONPATH "/work/imas/opt/SOLPS-GUI/1.5/src/widgets:${PYTHONPATH}"
+#setenv PYQTDESIGNERPATH "/work/imas/opt/SOLPS-GUI/1.5/src/plugins/designer"
+#setenv SOLPSGUI "/work/imas/opt/SOLPS-GUI/1.5/src/gui"
+#setenv SOLPSWORK /work/projects/solps-iter/$USER
+#alias solps 'python3 /work/imas/opt/SOLPS-GUI/1.5/src/gui/solps.py'
+#alias solps_doc 'xdg-open /work/imas/opt/SOLPS-GUI/1.5/doc/build/html/index.html'
+#alias solps_help 'assistant -collectionFile /work/imas/opt/SOLPS-GUI/1.5/doc/build/qthelp/SOLPSGUI.qhc'
+#alias eirene 'python3 /work/imas/opt/SOLPS-GUI/1.5/src/widgets/eirene.py'
+#alias b2 'python3 /work/imas/opt/SOLPS-GUI/1.5/src/widgets/b2.py'
+
