   <widget class="QCheckBox" name="checkBox_size_hints">
    <property name="geometry">
     <rect>
      <x>410</x>
      <y>70</y>
      <width>171</width>
      <height>20</height>
     </rect>
    </property>
    <property name="toolTip">
     <string>Inlude minimumSizeHint(self) and sizeHint(self) in the actor.</string>
    </property>
    <property name="whatsThis">
     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;The following overloaded functions are used as a hint for the size and are&lt;/p&gt;&lt;p&gt;not enforced. Therefore, the hints are used only when used under ``QLayout``&lt;/p&gt;&lt;p&gt;with resizable windows in a grid, vertical horizontal horizontal layouts.&lt;/p&gt;&lt;p&gt;def minimumSizeHint(self):&lt;/p&gt;&lt;p&gt;&amp;quot;&amp;quot;&amp;quot; This property holds the recommended minimum size for the widget&lt;/p&gt;&lt;p&gt;&amp;quot;&amp;quot;&amp;quot;&lt;/p&gt;&lt;p&gt;return QSize(200, 100)&lt;/p&gt;&lt;p&gt;&lt;br/&gt;def sizeHint(self):&lt;/p&gt;&lt;p&gt;&amp;quot;&amp;quot;&amp;quot; This property holds the recommended size for the widget&lt;/p&gt;&lt;p&gt;&amp;quot;&amp;quot;&amp;quot;&lt;/p&gt;&lt;p&gt;return QSize(200, 270)&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;p&gt;If the hint functions are missing in actor.py, then default sizing is used for the actor. &lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
    </property>
    <property name="text">
     <string>Size hints</string>
    </property>
    <property name="checked">
     <bool>true</bool>
    </property>
   </widget>
   <widget class="QCheckBox" name="checkBox_simple_actor">
    <property name="geometry">
     <rect>
      <x>410</x>
      <y>10</y>
      <width>131</width>
      <height>20</height>
     </rect>
    </property>
    <property name="toolTip">
     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Actor without menu UI or plugin&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
    </property>
    <property name="whatsThis">
     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;At minimum two files are needed for a simple actor:&lt;/p&gt;&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;&lt;li style=&quot; margin-top:12px; margin-bottom:12px; margin-left:30px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'monospace';&quot;&gt;actor.py&lt;/span&gt; that should be included in &lt;a name=&quot;index-0&quot;/&gt;&lt;span style=&quot; font-family:'monospace';&quot;&gt;P&lt;/span&gt;&lt;span style=&quot; font-family:'monospace';&quot;&gt;YTHONPATH&lt;/span&gt;, and&lt;/li&gt;&lt;li style=&quot; margin-top:12px; margin-bottom:12px; margin-left:30px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'monospace';&quot;&gt;registeractor.py&lt;/span&gt; that is only used in &lt;span style=&quot; font-style:italic;&quot;&gt;QT Designer&lt;/span&gt; and will be searched for in &lt;a name=&quot;index-1&quot;/&gt;&lt;span style=&quot; font-family:'monospace';&quot;&gt;P&lt;/span&gt;&lt;span style=&quot; font-family:'monospace';&quot;&gt;YSIDE_DESIGNER_PLUGINS&lt;/span&gt; environment variable directories.d will be searched for in PYSIDE_DESIGNER_PLUGINS environment variable directories. &lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</string>
    </property>
    <property name="text">
     <string>Simple actor</string>
    </property>
    <property name="checked">
     <bool>true</bool>
    </property>
   </widget>
