#%Module1.0###################################################################
## Module for use under SOLPS-ITER modules
##
set ver [lindex [split $ModulesCurrentModulefile / ] end ]
set name [lindex [split $ModulesCurrentModulefile / ] end-1 ]
set loading [module-info mode load]
set imas_home /work/imas
set fn [join [lrange [split $ModulesCurrentModulefile / ] 0 end-1 ] / ]/.desc
set desc [join [read [open $fn ]]]
proc ModulesHelp { } {
puts stderr "\tThis module sets the environment for $name v$ver"
}
conflict $name
module-whatis "$desc (v$ver)"

# Checking if paraview is loaded.
if { ! [ is-loaded paraview ] } { 
  module load paraview
} 
if { ! [ is-loaded blitz/10 ] } {
  module load blitz/0.10
}

if { ! [ is-loaded imas ] } {
  module load imas
}

set paraview_version $::env(PARAVIEW_VERSION)
set imas_version $::env(IMAS_VERSION)

if { [file exists /home/ITER/kosl/solps-gui ] } {
   set solpsguidir /home/ITER/kosl/solps-gui
} elseif { [file exists /pfs/work/g2kosl/solps-gui ] } {
   set solpsguidir /pfs/work/g2kosl/solps-gui
} elseif { [file exists $::env(USER)/solps-gui } {
   set solpsguidir $::env(USER)/solps-gui
} else {
   set solpsguidir $::env(SOLPSTOP)/modules/solps-gui
}

set pluginsdir  $solpsguidir/staging/paraview-plugins
set plugindir $pluginsdir/$paraview_version/$imas_version
if { [file exists $plugindir/libReadUALEdge.so] } {
	prepend-path PV_PLUGIN_PATH  $plugindir
} else {
	puts stderr "Warning: Missing $plugindir/libReadUALEdge.so"
	puts stderr "Try to rebuild it with 'cd $solpsguidir && ./build-paraview-plugin.sh'"
}
