#%Module1.0###################################################################
## Module for use under SOLPS-ITER modules
##
set ver [lindex [split $ModulesCurrentModulefile / ] end ]
set name [lindex [split $ModulesCurrentModulefile / ] end-1 ]
set loading [module-info mode load]
set imas_home /work/imas
set fn [join [lrange [split $ModulesCurrentModulefile / ] 0 end-1 ] / ]/.desc
set desc [join [read [open $fn ]]]
proc ModulesHelp { } {
puts stderr "\tThis module sets the environment for $name v$ver"
}
conflict $name
module-whatis "$desc (v$ver)"

# Checking if paraview is loaded.
if { ! [ is-loaded paraview ] } { 
  module load paraview
} 
if { ! [ is-loaded blitz/10 ] } {
  module load blitz/0.10
}
if { ! [ is-loaded imas ] } {
  module load imas
}

set paraview_version $::env(PARAVIEW_VERSION)
set imas_version $::env(IMAS_VERSION)

prepend-path PV_PLUGIN_PATH  $::env(SOLPSTOP)/modules/solps-gui/staging/paraview-plugins/$paraview_version/$imas_version
