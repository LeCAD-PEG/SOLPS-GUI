#%Module######################################################################
##
##      Solps-Gui Modulefile
##      author: Hajo Klingshirn
##

source "$env(ITMMODULESUTIL)/mod_tools.tcl"

set VERSION [get_version]

module-whatis "This module sets the environment for solps-gui"
conflict solps-gui 

module 		load pyqt/5.7.0-qt-5.7.0-python-3.5.2

set SWITMDIR [get_env SWITMDIR]
set solpsguihome /pfs/work/kosl/solps-gui

setenv SOLPSGUI $solpsguihome/src/gui
prepend-path PYTHONPATH $solpsguihome/src/widgets
prepend-path PYQTDESIGNERPATH $solpsguihome/src/plugins/designer

#setenv LD_PRELOAD /usr/lib64/libfontconfig.so.1
set-alias solps {python3 \$SOLPSGUI/solps.py $*}

set-alias solps_doc "firefox --url file:///pfs/work/kosl/solps-gui/doc//build/html/index.html"
